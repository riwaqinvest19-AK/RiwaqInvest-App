# Copy to .env and fill from Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Web auth emails: Supabase → Authentication → URL Configuration → Redirect URLs
# Add each origin + path (signup confirmation uses /login), e.g.:
#   http://localhost:8081/login
#   https://your-app.netlify.app/login
#   https://your-app.netlify.app/reset-password
# Site URL should match your production web origin.

# Optional
EXPO_PUBLIC_CHATBOT_API_URL=
EXPO_PUBLIC_PORTFOLIO_RETURNS_PDF_URL=

# For EAS APK builds: add the same keys in Expo dashboard → Project → Environment variables (production)
